# =============================================================================
# 生产环境变量模板（复制为 prod.env 后填入真实值；prod.env 不要提交）
# 加载方式见 deploy/README-生产启动.md
# =============================================================================

# ---- 运行 ----
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ---- MySQL（必填；建议最小权限账号，不要用 root）----
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/moyun?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&rewriteBatchedStatements=true&cachePrepStmts=true&prepStmtCacheSize=250&prepStmtCacheSqlLimit=2048&useServerPrepStmts=true
MYSQL_USERNAME=moyun
MYSQL_PASSWORD=CHANGE_ME

# ---- Redis（必填）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=CHANGE_ME

# ---- JWT（必填；至少 64 字符随机串，三套密钥建议各不相同）----
TOKEN_SECRET=CHANGE_ME_64_CHARS_RANDOM
TOKEN_ADMIN_SECRET=CHANGE_ME_ADMIN_64_CHARS
TOKEN_PORTAL_SECRET=CHANGE_ME_PORTAL_64_CHARS

# ---- MinIO（必填；access-url 必须是手机/浏览器可访问的公网地址）----
MINIO_ENDPOINT=http://127.0.0.1:9001
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_NAME=moyun
MINIO_ACCESS_URL=https://oss.example.com

# ---- Druid 控制台（默认关闭；排障时再开，并设置强口令）----
DRUID_STAT_ENABLED=false
DRUID_USERNAME=
DRUID_PASSWORD=

# ---- Swagger / Knife4j（生产必须关闭）----
KNIFE4J_ENABLE=false

# ---- 支付 / 短信（未开通时保持 false；开通后填对应凭据）----
PAY_ENABLED=false
WECHAT_PAY_APP_ID=unused
WECHAT_PAY_MCH_ID=unused
WECHAT_PAY_MERCHANT_SERIAL=unused
WECHAT_PAY_PRIVATE_KEY_PATH=unused
WECHAT_PAY_API_V3_KEY=unused
WECHAT_PAY_NOTIFY_URL=https://example.com/prod-api/portal/pay/notify
MOYUN_PAY_SECURITY_BANKCARDENCRYPTKEY=unused

SMS_ENABLED=false
MOYUN_SMS_ALIYUN_ACCESSKEYID=unused
MOYUN_SMS_ALIYUN_ACCESSKEYSECRET=unused
SMS_ALIYUN_TEMPLATE_CODE=unused

# ---- 证件号加密密钥（必填；用于加密存储身份证/银行卡等敏感字段）----
MOYUN_SECURITY_CERT_NO_ENCRYPT_KEY=CHANGE_ME_32_CHARS

# ---- 邮件（注册/找回密码/定时提醒；不配置则相关功能不可用）----
MAIL_USERNAME=
MAIL_PASSWORD=
