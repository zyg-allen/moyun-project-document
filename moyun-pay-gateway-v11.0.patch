+  readFlag?: number;
+  createTime?: string;
+}
+
+/** 支付通知分页结果 */
+export interface PayNotificationListResult {
+  records: PayNotification[];
+  total: number;
+  current: number;
+  size: number;
+  unreadCount?: number;
+}
