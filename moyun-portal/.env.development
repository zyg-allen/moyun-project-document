# 开发环境配置
# 走 vite 同源代理（/api → localhost:8080，见 vite.config.ts）：
# 1. 手机等局域网设备经 https 访问时，localhost 绝对地址会指向设备自身导致请求失败
# 2. https 页面禁止混合内容（http/ws 直连会被浏览器拦截），同源 wss 链路可正常转写
VITE_API_BASE_URL=/api

# 站点域名（用于 canonical / og:url / JSON-LD）；留空 = 使用"当前访问源"
VITE_SITE_URL=

# og:image 默认图；留空 = 使用代码内置默认图
VITE_DEFAULT_OG_IMAGE=
