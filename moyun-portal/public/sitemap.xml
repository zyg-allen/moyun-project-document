<?xml version="1.0" encoding="UTF-8"?>
<!--
  旭林知行 静态网站地图（fallback）
  说明：
  1. 主用动态 sitemap：GET /portal/sitemap （由 PortalSitemapController 实时生成，覆盖文章/书籍/书单/话题/专栏/面经等）
  2. 本静态文件仅作为后端不可用时的兜底，仅包含固定页面
  3. 部署时请将 https://xulin.example.com 替换为实际正式域名（与后端 moyun.portal.domain 配置保持一致）
  4. robots.txt 已将 Sitemap 行指向动态接口 /portal/sitemap
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <!-- 首页 -->
  <url>
    <loc>https://xulin.example.com/</loc>
    <lastmod>2026-06-09</lastmod>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <!-- 语义化分类列表页 -->
  <url>
    <loc>https://xulin.example.com/category</loc>
    <lastmod>2026-06-09</lastmod>
