# =============================================================================
# 墨韵后端生产环境配置模板（application-prod.yaml.example）
# -----------------------------------------------------------------------------
# 使用说明：
# 1. 复制本文件为 application-prod.yaml：cp application-prod.yaml.example application-prod.yaml
# 2. 通过环境变量或外部配置注入实际凭据，切勿在文件中直接写入明文密钥
# 3. 启动时指定 profile：--spring.profiles.active=prod
# 4. 所有 ${ENV_VAR} 占位符均为必填项，未设置时应用将 fail-fast 拒绝启动
# =============================================================================

server:
  port: ${SERVER_PORT:8080}

spring:
  # =============================================
  # MySQL 数据源配置（生产环境必填）
  # - MYSQL_URL：完整 JDBC 连接串，建议开启 useSSL=true
  # - MYSQL_USERNAME / MYSQL_PASSWORD：数据库账号，建议使用最小权限账号
  # =============================================
  datasource:
    type: com.alibaba.druid.pool.DruidDataSource
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: ${MYSQL_URL}
    username: ${MYSQL_USERNAME}
    password: ${MYSQL_PASSWORD}
    druid:
      # 连接池基础配置（生产环境建议根据实际负载调整）
      initial-size: 10
      min-idle: 10
      max-active: 50
      max-wait: 60000
      connect-timeout: 30000
      socket-timeout: 60000
      # 连接检测
      time-between-eviction-runs-millis: 60000
      min-evictable-idle-time-millis: 300000
      max-evictable-idle-time-millis: 900000
      validation-query: SELECT 1
      test-while-idle: true
      test-on-borrow: false
      test-on-return: false
      pool-prepared-statements: true
      # 监控统计
      filters: stat,wall,slf4j
      filter:
        stat:
          merge-sql: true
          slow-sql-millis: 3000
          log-slow-sql: true
        wall:
          config:
            multi-statement-allow: false
      # Druid Web 监控页：生产环境建议关闭（enabled=false）或必须修改默认凭据
      web-stat-filter:
        enabled: true
        url-pattern: /*
        exclusions: "*.js,*.gif,*.jpg,*.png,*.css,*.ico,/druid/*"
      stat-view-servlet:
        enabled: true
        url-pattern: /druid/*
        reset-enable: false
        # 生产环境必须设置强密码，且通过 SecurityConfig 限制为 ADMIN 角色访问
        login-username: ${DRUID_USERNAME}
        login-password: ${DRUID_PASSWORD}
        # 生产环境限定可访问 IP，默认 127.0.0.1（仅本机），多机部署请通过 DRUID_ALLOW_IP 显式注入
        # 例如：DRUID_ALLOW_IP=10.0.0.0/24,192.168.1.100
        allow: ${DRUID_ALLOW_IP:127.0.0.1}
        deny: ""
      aop-patterns: com.moyun.system.service.*

  # =============================================
  # Redis 配置（生产环境必填）
  # - REDIS_HOST / REDIS_PORT：Redis 实例地址
  # - REDIS_PASSWORD：生产环境必须设置强密码
  # =============================================
  data:
    redis:
      host: ${REDIS_HOST}
      port: ${REDIS_PORT:6379}
      database: ${REDIS_DATABASE:0}
      password: ${REDIS_PASSWORD}
      timeout: 3000
      lettuce:
        pool:
          max-active: 16
          max-wait: -1
          max-idle: 8
          min-idle: 0

    # MongoDB 配置（可选，不使用时保持默认值即可，应用不会因连接失败而启动失败）
    mongodb:
      uri: ${MONGODB_URI:mongodb://localhost:27017/moyun}
      auto-index-creation: false

# =============================================
# 日志配置（生产环境使用 info，避免 debug 日志泄露敏感信息）
# =============================================
logging:
  level:
    com.moyun: info
    org.springframework: warn
  pattern:
    console: '%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n'

# =============================================
# Token 配置
# - TOKEN_SECRET：JWT 签名密钥，必须至少 32 字符，建议使用强随机串
#   生成方式示例：openssl rand -base64 64
#   未配置或长度不足 32 字符时应用将 fail-fast 拒绝启动
# - TOKEN_EXPIRE_TIME：Token 有效期（分钟），生产建议 120
# =============================================
token:
  header: Authorization
  secret: ${TOKEN_SECRET}
  expireTime: ${TOKEN_EXPIRE_TIME:120}

# =============================================
# 安全配置
# =============================================
security:
  exclude-modules: /portal/**,/external/**,/doc.html,/swagger-ui.html

# =============================================
# 验证码配置
# =============================================
captcha:
  enabled: true
  type: math
  length: 2
  width: 160
  height: 60

# =============================================
# 用户配置
# =============================================
user:
  password:
    maxRetryCount: 5
    lockTime: 10

# =============================================
# 防止 XSS 攻击
# urlPatterns 必须覆盖所有 UGC 入口（portal/cms），否则文章/评论/话题/私信等无 XSS 防护
# =============================================
xss:
  enabled: true
  excludes: /system/notification
  urlPatterns: /system/*,/monitor/*,/tool/*,/portal/*,/cms/*

# =============================================
# knife4j 配置
# - 生产环境建议 KNIFE4J_PRODUCTION=true 关闭 Swagger 文档，避免接口暴露
# =============================================
knife4j:
  enable: ${KNIFE4J_ENABLE:false}
  setting:
    language: zh_cn
  production: ${KNIFE4J_PRODUCTION:true}

# =============================================
# 墨韵框架配置
# - MOYUN_PROFILE：本地文件存储根路径（生产环境建议使用独立挂载盘）
# =============================================
moyun:
  name: moyun
  version: 4.x
  copyrightYear: 2024
  demoEnabled: false
  addressEnabled: false
  profile: ${MOYUN_PROFILE:/data/moyun/profile}

# =============================================
# 项目配置（兼容原 ruoyi 配置，部分旧代码可能读取）
# =============================================
ruoyi:
  name: Moyun
  version: 1.0.0
  profile: ${MOYUN_PROFILE:/data/moyun/profile}
  importPath: ${MOYUN_PROFILE:/data/moyun/profile}/import
  captchaType: math

# =============================================
# MyBatis-Plus 配置
# =============================================
mybatis-plus:
  mapper-locations: classpath*:/mapper/**/*.xml
  type-aliases-package: com.moyun.core.base.entity,com.moyun.system.domain.entity,com.moyun.portal.domain.entity,com.moyun.ext.cms.domain.entity,com.moyun.ext.job.domain.entity,com.moyun.ext.ai.entity
  configuration:
    map-underscore-to-camel-case: true
    # 生产环境关闭 SQL 日志，避免性能损耗与敏感信息泄露
    log-impl: org.apache.ibatis.logging.nologging.NoLoggingImpl
  global-config:
    db-config:
      id-type: auto
      # 逻辑删除：与 dev/local 环境及 BaseEntity 的 @TableLogic 注解保持一致
      # 字段 del_flag（char(1)），"0"=存在 "2"=删除（RuoYi 框架惯例）
      # ⚠️ 切勿改为 deleted/1/0，否则与 BaseEntity 注解不一致会导致生产环境软删失效
      logic-delete-field: delFlag
      logic-delete-value: "2"
      logic-not-delete-value: "0"

# =============================================
# MinIO 文件存储配置（生产环境必填）
# - MINIO_ENDPOINT：MinIO 服务地址（建议内网地址）
# - MINIO_ACCESS_KEY / MINIO_SECRET_KEY：访问凭据，建议使用最小权限账号
# - MINIO_BUCKET_NAME：存储桶名称（需提前创建）
# =============================================
minio:
  enabled: true
  endpoint: ${MINIO_ENDPOINT}
  access-key: ${MINIO_ACCESS_KEY}
  secret-key: ${MINIO_SECRET_KEY}
  bucket-name: ${MINIO_BUCKET_NAME:moyun}
  access-url: ${MINIO_ACCESS_URL}
  auto-fallback: false
  fallback-to-local: false

# =============================================
# 文件上传配置（与 AI 知识库文档 50MB 上限对齐）
# =============================================
spring.servlet.multipart:
  max-file-size: 50MB
  max-request-size: 50MB

# =============================================
# AI 模块配置（生产环境按需启用）
# - 默认全部关闭，避免依赖中间件缺失导致启动失败
# - 启用 AI 时需同步部署：MySQL（AI 表）/ Redis / Elasticsearch / LibreOffice
# =============================================

# LangChain4j 大模型对接（任选其一，按 ${PROVIDER}_ENABLED=true 启用）
langchain4j:
  enabled: ${AI_ENABLED:false}
  open-ai:
    enabled: ${OPENAI_ENABLED:false}
    api-key: ${OPENAI_API_KEY:}
    model-name: ${OPENAI_MODEL:gpt-4o-mini}
    temperature: 0.7
  ollama:
    enabled: ${OLLAMA_ENABLED:false}
    base-url: ${OLLAMA_BASE_URL:http://localhost:11434}
    model-name: ${OLLAMA_MODEL:qwen2.5}
    temperature: 0.7
  dashscope:
    enabled: ${DASHSCOPE_ENABLED:false}
    api-key: ${DASHSCOPE_API_KEY:}
    chat-model: ${DASHSCOPE_CHAT_MODEL:qwen-plus}
    embedding-model: ${DASHSCOPE_EMBEDDING_MODEL:text-embedding-v3}
    rerank-model: ${DASHSCOPE_RERANK_MODEL:gte-rerank}
    temperature: 0.7

# 向量存储配置（知识库 / RAG 检索底座）
# type: redis（默认，复用 Redis 8.0+ RediSearch）/ es（独立 ES 集群）
app:
  embedding-store:
    type: ${EMBEDDING_STORE_TYPE:redis}
    index-name: ${EMBEDDING_STORE_INDEX_NAME:moyun_ai_vectors}
    key-prefix: ${EMBEDDING_STORE_KEY_PREFIX:ai_vectors:}

# Elasticsearch 配置（仅 app.embedding-store.type=es 时生效）
elasticsearch:
  uris: ${ES_URIS:http://localhost:9200}
  username: ${ES_USERNAME:}
  password: ${ES_PASSWORD:}
  index-prefix: ${ES_INDEX_PREFIX:moyun_ai_}
  index:
    vector: ${ES_INDEX_VECTOR:moyun_ai_vectors}

# LibreOffice 文档转 PDF（启用 AI 知识库 Office 文档解析时必填）
jodconverter:
  # 注意：local.enabled 必须与主开关同步，否则 JodConverterLocalAutoConfiguration 仍会触发 localOfficeManager 创建
  enabled: ${LIBREOFFICE_ENABLED:false}
  local:
    enabled: ${LIBREOFFICE_ENABLED:false}
    office-home: ${LIBREOFFICE_HOME:/usr/lib/libreoffice}
    max-tasks-per-process: 200
    task-execution-timeout: 120000
    task-queue-timeout: 30000
    port-numbers:
      - 2002

# 墨韵 AI 专用配置
moyun-ai:
  rag:
    default-min-score: 0.7
    default-max-results: 5
    chunk-size: 512
    chunk-overlap: 50
    min-recall-count: 15
    recall-multiplier: 2.0
    enable-hybrid-search: true
    enable-query-expansion: true
    bm25-weight: 0.3
    vector-weight: 0.7
    verbose-logging: false
    enable-query-rewriting: true
    enable-self-rag: true
    self-rag-min-relevance: 0.5
    self-rag-max-verify-count: 5
    enable-conversation-summary: true
    summary-threshold: 20
    summary-keep-recent: 10
    enable-intent-recognition: true
  storage:
    knowledge-base-dir: ${MOYUN_KB_DIR:${MOYUN_PROFILE:/data/moyun/profile}/ai/knowledge}
    image-dir: ${MOYUN_IMG_DIR:${MOYUN_PROFILE:/data/moyun/profile}/ai/images}
  rate-limit:
    chat-requests-per-minute: 60
    knowledge-upload-mb-per-hour: 500

# 对话上下文
chat:
  max-messages: 20
