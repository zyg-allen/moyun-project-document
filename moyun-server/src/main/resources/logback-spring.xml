<?xml version="1.0" encoding="UTF-8"?>
<!--
    墨云服务日志配置（统一日志 + 模块标识方案）

    ===== 设计原则 =====
    1. 统一输出：所有日志写入同一个主日志文件，保证完整调用链
    2. 错误分离：ERROR 级别独立输出，便于告警和快速定位
    3. 慢SQL审计：独立输出，便于性能分析和治理
    4. 模块标识：日志内容中包含 [AI]、[CMS]、[CORE] 等模块标签，便于过滤
    5. 生产就绪：保留策略和大小限制已按生产环境调整

    ===== 日志文件说明 =====
    - moyun-server.log         主日志（所有级别，含完整调用链）
    - moyun-server-error.log   错误日志（仅ERROR，用于告警）
    - moyun-server-slow-sql.log 慢SQL审计日志

    ===== 排查方式 =====
    - 按 traceId 查全链路：grep "traceId-xxx" moyun-server.log
    - 按模块查日志：grep "\[AI\]" moyun-server.log
    - 按用户查日志：grep "userId=123" moyun-server.log
    - 组合查询：grep "traceId-xxx" moyun-server.log | grep "\[AI\]"
-->
<configuration>

    <!-- ===== 基础属性 ===== -->
    <property name="LOG_HOME" value="logs"/>
    <property name="APP_NAME" value="moyun-server"/>
    <property name="MAX_HISTORY" value="30"/>
    <property name="TOTAL_SIZE_CAP" value="10GB"/>

    <!-- ===== 彩色日志依赖 ===== -->
    <conversionRule conversionWord="clr" converterClass="org.springframework.boot.logging.logback.ColorConverter"/>
    <conversionRule conversionWord="wex" converterClass="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter"/>
    <conversionRule conversionWord="wEx" converterClass="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter"/>

    <!-- ===== 日志输出格式 ===== -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr(${PID:- }){magenta} %clr([%X{traceId:-NO_TRACE}]){yellow} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n%clr(%ex){red}"/>

    <property name="FILE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %5p ${PID:- } [%X{traceId:-NO_TRACE}] [%t] %-40.40logger{39}.%M:%L : %m%n"/>

    <property name="ERROR_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %5p ${PID:- } [%X{traceId:-NO_TRACE}] [%t] %-40.40logger{39}.%M:%L : %m%n%ex{full}"/>

    <!-- ===== 控制台输出（开发/测试用） ===== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ===== 主日志文件 ===== -->
    <appender name="MAIN_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}.log</file>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <cleanHistoryOnStart>true</cleanHistoryOnStart>
    </appender>

    <!-- ===== 错误日志独立文件 ===== -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}-error.log</file>
        <encoder>
            <pattern>${ERROR_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${APP_NAME}-error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <!-- ===== 慢SQL审计日志 ===== -->
    <appender name="SLOW_SQL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}-slow-sql.log</file>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${APP_NAME}-slow-sql.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ===== 异步包装器（提升性能） ===== -->
    <appender name="ASYNC_MAIN_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <discardingThreshold>0</discardingThreshold>
        <queueSize>512</queueSize>
        <includeCallerData>true</includeCallerData>
        <appender-ref ref="MAIN_FILE"/>
    </appender>

    <appender name="ASYNC_ERROR_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <discardingThreshold>0</discardingThreshold>
        <queueSize>256</queueSize>
        <includeCallerData>true</includeCallerData>
        <appender-ref ref="ERROR_FILE"/>
    </appender>

    <appender name="ASYNC_SLOW_SQL_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <discardingThreshold>0</discardingThreshold>
        <queueSize>128</queueSize>
        <includeCallerData>true</includeCallerData>
        <appender-ref ref="SLOW_SQL_FILE"/>
    </appender>

    <!-- ===== 日志级别配置 ===== -->

    <!-- 应用包：生产环境 INFO，开发可改为 DEBUG -->
    <logger name="com.moyun" level="INFO"/>

    <!-- Mapper SQL：生产环境 WARN（不输出SQL），开发可改为 DEBUG -->
    <logger name="com.moyun.*.mapper" level="WARN"/>

    <!-- 第三方库：降低噪音 -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.springframework.web" level="WARN"/>
    <logger name="org.apache" level="WARN"/>
    <logger name="com.baomidou.mybatisplus" level="WARN"/>
    <logger name="io.github.jbellis.jvector" level="WARN"/>
    <logger name="dev.langchain4j" level="WARN"/>
    <logger name="io.minio" level="WARN"/>

    <!-- Druid 慢SQL：独立记录，不写入主日志 -->
    <logger name="druid.sql" level="WARN" additivity="false">
        <appender-ref ref="ASYNC_SLOW_SQL_FILE"/>
    </logger>
    <logger name="SLOW_SQL" level="WARN" additivity="false">
        <appender-ref ref="ASYNC_SLOW_SQL_FILE"/>
    </logger>

    <!-- ===== 根日志 ===== -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_MAIN_FILE"/>
        <appender-ref ref="ASYNC_ERROR_FILE"/>
    </root>

</configuration>