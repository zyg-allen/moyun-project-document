<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moyun.portal.mapper.PortalAchievementMapper">

    <select id="selectAllEnabled" resultType="com.moyun.portal.domain.entity.PortalAchievement">
        SELECT * FROM portal_achievement WHERE status = '0' ORDER BY sort
    </select>

    <select id="selectByCode" resultType="com.moyun.portal.domain.entity.PortalAchievement">
        SELECT * FROM portal_achievement WHERE code = #{code}
    </select>

</mapper>
