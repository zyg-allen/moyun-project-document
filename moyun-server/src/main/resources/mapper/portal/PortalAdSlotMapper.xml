<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moyun.portal.mapper.PortalAdSlotMapper">

    <resultMap type="com.moyun.portal.domain.entity.PortalAdSlot" id="PortalAdSlotResult">
        <id property="id" column="id"/>
        <result property="slotKey" column="slot_key"/>
        <result property="title" column="title"/>
        <result property="image" column="image"/>
        <result property="link" column="link"/>
        <result property="content" column="content"/>
        <result property="sort" column="sort"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectPortalAdSlotVo">
        select id, slot_key, title, image, link, content, sort, status, create_by, create_time, update_by, update_time, remark from portal_ad_slot
    </sql>

    <!-- 通用查询条件片段 -->
    <sql id="queryWhere">
        <where>
            <if test="params.slotKey != null and params.slotKey != ''">
                AND slot_key = #{params.slotKey}
            </if>
            <if test="params.title != null and params.title != ''">
                AND title like concat('%', #{params.title}, '%')
            </if>
            <if test="params.status != null and params.status != ''">
                AND status = #{params.status}
            </if>
        </where>
    </sql>

    <!-- 通用排序片段（默认排序，按 sort 升序） -->
    <sql id="defaultOrderBy">
        order by sort asc, id asc
    </sql>

    <!-- 动态排序片段 -->
    <sql id="dynamicOrderBy">
        <if test="params.orderByColumn != null and params.orderByColumn != ''">
            order by ${params.orderByColumn}
            <if test="params.isAsc != null and params.isAsc != ''">
                ${params.isAsc}
            </if>
        </if>
        <if test="params.orderByColumn == null or params.orderByColumn == ''">
            <include refid="defaultOrderBy"/>
        </if>
    </sql>

    <!-- 分页查询 -->
    <select id="selectPortalAdSlotPage" resultMap="PortalAdSlotResult">
        <include refid="selectPortalAdSlotVo"/>
        <include refid="queryWhere"/>
        <include refid="dynamicOrderBy"/>
    </select>

    <!-- 不分页查询（用于导出等场景） -->
    <select id="selectPortalAdSlotList" resultMap="PortalAdSlotResult">
        <include refid="selectPortalAdSlotVo"/>
        <include refid="queryWhere"/>
        <include refid="defaultOrderBy"/>
    </select>

    <select id="selectPortalAdSlotById" parameterType="Long" resultMap="PortalAdSlotResult">
        <include refid="selectPortalAdSlotVo"/>
        where id = #{id}
    </select>

    <insert id="insertPortalAdSlot" parameterType="com.moyun.portal.domain.entity.PortalAdSlot" useGeneratedKeys="true" keyProperty="id">
        insert into portal_ad_slot
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="slotKey != null">slot_key,</if>
            <if test="title != null">title,</if>
            <if test="image != null">image,</if>
            <if test="link != null">link,</if>
            <if test="content != null">content,</if>
            <if test="sort != null">sort,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="slotKey != null">#{slotKey},</if>
            <if test="title != null">#{title},</if>
            <if test="image != null">#{image},</if>
            <if test="link != null">#{link},</if>
            <if test="content != null">#{content},</if>
            <if test="sort != null">#{sort},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updatePortalAdSlot" parameterType="com.moyun.portal.domain.entity.PortalAdSlot">
        update portal_ad_slot
        <trim prefix="SET" suffixOverrides=",">
            <if test="slotKey != null and slotKey != ''">slot_key = #{slotKey},</if>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="image != null">image = #{image},</if>
            <if test="link != null">link = #{link},</if>
            <if test="content != null">content = #{content},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePortalAdSlotById" parameterType="Long">
        delete from portal_ad_slot where id = #{id}
    </delete>

    <delete id="deletePortalAdSlotByIds" parameterType="Long">
        delete from portal_ad_slot where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
