<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moyun.portal.mapper.PortalArticleMapper">

    <resultMap type="com.moyun.portal.domain.entity.PortalArticle" id="PortalArticleResult">
        <id property="id" column="id"/>
        <result property="businessId" column="business_id"/>
        <result property="title" column="title"/>
        <result property="slug" column="slug"/>
        <result property="content" column="content"/>
        <result property="excerpt" column="excerpt"/>
        <result property="cover" column="cover"/>
        <result property="authorId" column="author_id"/>
        <result property="authorBusinessId" column="author_business_id"/>
        <result property="categoryId" column="category_id"/>
        <result property="categoryBusinessId" column="category_business_id"/>
        <result property="rootCategoryId" column="root_category_id"/>
        <result property="rootCategoryBusinessId" column="root_category_business_id"/>
        <result property="categoryPath" column="category_path"/>
        <result property="categoryName" column="category_name"/>
        <result property="categorySlug" column="category_slug"/>
        <result property="status" column="status"/>
        <result property="isFeatured" column="is_featured"/>
        <result property="isTop" column="is_top"/>
        <result property="isCarousel" column="is_carousel"/>
        <result property="isCategoryRecommended" column="is_category_recommended"/>
        <result property="views" column="views"/>
        <result property="likes" column="likes"/>
        <result property="comments" column="comments"/>
        <result property="shareCount" column="share_count"/>
        <result property="bookmarkCount" column="bookmark_count"/>
        <result property="publishedAt" column="published_at"/>
        <result property="link" column="link"/>
        <result property="editorMode" column="editor_mode"/>
        <result property="sessionToken" column="session_token"/>
        <result property="contentMarkdown" column="content_markdown"/>
        <result property="isPaid" column="is_paid"/>
        <result property="paidContent" column="paid_content"/>
        <result property="previewLength" column="preview_length"/>
        <result property="price" column="price"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <result property="authorNickname" column="author_nickname"/>
        <result property="authorUsername" column="author_username"/>
        <result property="authorAvatar" column="author_avatar"/>
    </resultMap>

    <resultMap type="com.moyun.ext.cms.domain.vo.CmsArticleVO" id="CmsArticleResult">
        <id property="id" column="id"/>
        <result property="businessId" column="business_id"/>
        <result property="authorBusinessId" column="author_business_id"/>
        <result property="categoryBusinessId" column="category_business_id"/>
        <result property="rootCategoryBusinessId" column="root_category_business_id"/>
        <result property="title" column="title"/>
        <result property="slug" column="slug"/>
        <result property="content" column="content"/>
        <result property="excerpt" column="excerpt"/>
        <result property="cover" column="cover"/>
        <result property="authorId" column="author_id"/>
        <result property="categoryId" column="category_id"/>
        <result property="rootCategoryId" column="root_category_id"/>
        <result property="categoryPath" column="category_path"/>
        <result property="categoryName" column="category_name"/>
        <result property="categorySlug" column="category_slug"/>
        <result property="status" column="status"/>
        <result property="isFeatured" column="is_featured"/>
        <result property="isTop" column="is_top"/>
        <result property="isCarousel" column="is_carousel"/>
        <result property="isCategoryRecommended" column="is_category_recommended"/>
        <result property="views" column="views"/>
        <result property="likes" column="likes"/>
        <result property="comments" column="comments"/>
        <result property="shareCount" column="share_count"/>
        <result property="bookmarkCount" column="bookmark_count"/>
        <result property="publishedAt" column="published_at"/>
        <result property="link" column="link"/>
        <result property="editorMode" column="editor_mode"/>
        <result property="sessionToken" column="session_token"/>
        <result property="contentMarkdown" column="content_markdown"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <!-- 作者信息 -->
        <result property="authorNickname" column="author_nickname"/>
        <result property="authorUsername" column="author_username"/>
        <result property="authorAvatar" column="author_avatar"/>
    </resultMap>

    <sql id="selectPortalArticleVo">
        select pa.id, pa.title, pa.slug, pa.content, pa.excerpt, pa.cover, pa.author_id, pa.author_business_id,
               pa.category_id, pa.category_business_id, pa.root_category_id, pa.root_category_business_id, pa.category_path,
               pa.status,
               pa.is_featured, pa.is_top, pa.is_carousel, pa.is_category_recommended, pa.views, pa.likes, pa.comments, pa.share_count,
               pa.bookmark_count, pa.published_at, pa.link, pa.editor_mode, pa.session_token, pa.content_markdown,
               pa.is_paid, pa.paid_content, pa.preview_length, pa.price,
               pa.create_by, pa.create_time, pa.update_by, pa.update_time, pa.remark, pa.business_id,
               pc.name as category_name, pc.slug as category_slug,
               pu.nickname as author_nickname, pu.username as author_username, pu.avatar as author_avatar
        from portal_article pa
        left join portal_category pc on pa.category_id = pc.id
        left join portal_user pu on pa.author_id = pu.id
    </sql>

    <!-- CMS文章查询，不限制状态，包含作者信息 -->
    <sql id="selectCmsArticleVo">
        select pa.id, pa.title, pa.slug, pa.content, pa.excerpt, pa.cover, pa.author_id, pa.category_id, 
               pa.root_category_id, pa.category_path, 
               pa.status,
               pa.is_featured, pa.is_top, pa.is_carousel, pa.is_category_recommended, pa.views, pa.likes, pa.comments, pa.share_count,
               pa.bookmark_count, pa.published_at, pa.link, pa.editor_mode, pa.session_token, pa.content_markdown,
               pa.create_by, pa.create_time, pa.update_by, pa.update_time, pa.remark,
               pa.business_id, pa.author_business_id, pa.category_business_id, pa.root_category_business_id,
               pc.name as category_name, pc.slug as category_slug,
               pu.nickname as author_nickname, pu.username as author_username, pu.avatar as author_avatar
        from portal_article pa
        left join portal_category pc on pa.category_id = pc.id
        left join portal_user pu on pa.author_id = pu.id
    </sql>

    <!-- 通用查询条件片段（前台，不限制状态由queryWhereCms处理） -->
    <sql id="queryWhere">
        <where>
            pa.del_flag = '0'
            AND pa.status = 'published'
            <if test="params.title != null and params.title != ''">
                AND pa.title like concat('%', #{params.title}, '%')
            </if>
            <if test="params.authorId != null">
                AND pa.author_id = #{params.authorId}
            </if>
            <if test="params.categoryId != null">
                AND pa.category_id = #{params.categoryId}
            </if>
            <if test="params.rootCategoryId != null">
                AND pa.root_category_id = #{params.rootCategoryId}
            </if>
            <if test="params.categoryName != null and params.categoryName != ''">
                AND pc.name = #{params.categoryName}
            </if>
            <if test="params.status != null and params.status != ''">
                AND pa.status = #{params.status}
            </if>
            <if test="params.isTop != null">
                AND pa.is_top = #{params.isTop}
            </if>
            <if test="params.isFeatured != null">
                AND pa.is_featured = #{params.isFeatured}
            </if>
            <if test="params.isCarousel != null">
                AND pa.is_carousel = #{params.isCarousel}
            </if>
            <if test="params.isCategoryRecommended != null">
                AND pa.is_category_recommended = #{params.isCategoryRecommended}
            </if>
        </where>
    </sql>

    <!-- CMS查询条件片段（不自动过滤状态；默认排除已逻辑删除，CMS 后台如需查看已删除数据可走独立接口） -->
    <sql id="queryWhereCms">
        <where>
            pa.del_flag = '0'
            <if test="params.title != null and params.title != ''">
                AND pa.title like concat('%', #{params.title}, '%')
            </if>
            <if test="params.authorId != null">
                AND pa.author_id = #{params.authorId}
            </if>
            <if test="params.categoryId != null">
                AND pa.category_id = #{params.categoryId}
            </if>
            <if test="params.rootCategoryId != null">
                AND pa.root_category_id = #{params.rootCategoryId}
            </if>
            <if test="params.categoryName != null and params.categoryName != ''">
                AND pc.name = #{params.categoryName}
            </if>
            <if test="params.status != null and params.status != ''">
                AND pa.status = #{params.status}
            </if>
            <if test="params.isTop != null">
                AND pa.is_top = #{params.isTop}
            </if>
            <if test="params.isFeatured != null">
                AND pa.is_featured = #{params.isFeatured}
            </if>
            <if test="params.isCarousel != null">
                AND pa.is_carousel = #{params.isCarousel}
            </if>
            <if test="params.isCategoryRecommended != null">
                AND pa.is_category_recommended = #{params.isCategoryRecommended}
            </if>
        </where>
    </sql>

    <!-- "我的文章"查询条件片段（强制 author_id，status 可选，不强制 published；排除已逻辑删除） -->
    <sql id="queryWhereMy">
        <where>
            pa.del_flag = '0'
            AND pa.author_id = #{params.authorId}
            <if test="params.title != null and params.title != ''">
                AND pa.title like concat('%', #{params.title}, '%')
            </if>
            <if test="params.status != null and params.status != ''">
                AND pa.status = #{params.status}
            </if>
            <if test="params.categoryId != null">
                AND pa.category_id = #{params.categoryId}
            </if>
        </where>
    </sql>

    <!-- 通用排序片段（默认排序） -->
    <sql id="defaultOrderBy">
        order by pa.is_top desc, pa.published_at desc, pa.create_time desc
    </sql>

    <!-- 动态排序片段 -->
    <sql id="dynamicOrderBy">
        <if test="params.orderByColumn != null and params.orderByColumn != ''">
            order by pa.${params.orderByColumn}
            <if test="params.isAsc != null and params.isAsc != ''">
                ${params.isAsc}
            </if>
        </if>
        <if test="params.orderByColumn == null or params.orderByColumn == ''">
            <include refid="defaultOrderBy"/>
        </if>
    </sql>

    <!-- 分页查询 -->
    <select id="selectPortalArticlePage" resultMap="PortalArticleResult">
        <include refid="selectPortalArticleVo"/>
        <include refid="queryWhere"/>
        <include refid="dynamicOrderBy"/>
    </select>

    <!-- "我的文章"分页查询（按 authorId 过滤，status 可选） -->
    <select id="selectMyArticlesPage" resultMap="PortalArticleResult">
        <include refid="selectPortalArticleVo"/>
        <include refid="queryWhereMy"/>
        order by pa.update_time desc
    </select>

    <!-- 不分页查询（用于导出等场景） -->
    <select id="selectPortalArticleList" resultMap="PortalArticleResult">
        <include refid="selectPortalArticleVo"/>
        <include refid="queryWhere"/>
        <include refid="defaultOrderBy"/>
    </select>

    <!-- 查询热门文章（按浏览量排序） -->
    <select id="selectHotArticles" resultMap="PortalArticleResult">
        <include refid="selectPortalArticleVo"/>
        <where>
            pa.del_flag = '0'
            AND pa.status = 'published'
        </where>
        order by pa.views desc, pa.create_time desc
    </select>

    <!-- 查询精选文章 -->
    <select id="selectFeaturedArticles" resultMap="PortalArticleResult">
        <include refid="selectPortalArticleVo"/>
        <where>
            pa.del_flag = '0'
            AND pa.status = 'published'
            AND pa.is_featured = true
        </where>
        order by pa.is_top desc, pa.published_at desc, pa.create_time desc
    </select>

    <!-- 查询轮播文章 -->
    <select id="selectCarouselArticles" resultMap="PortalArticleResult">
        <include refid="selectPortalArticleVo"/>
        <where>
            pa.del_flag = '0'
            AND pa.status = 'published'
            AND pa.is_carousel = true
        </where>
        order by pa.create_time desc
    </select>

    <!-- 查询相关文章 -->
    <select id="selectRelatedArticles" resultMap="PortalArticleResult">
        <include refid="selectPortalArticleVo"/>
        <where>
            pa.del_flag = '0'
            AND pa.status = 'published'
            AND pa.id != #{currentId}
        </where>
        order by pa.create_time desc
    </select>

    <!-- 查询最新文章 -->
    <select id="selectLatestArticles" resultMap="PortalArticleResult">
        <include refid="selectPortalArticleVo"/>
        <where>
            pa.del_flag = '0'
            AND pa.status = 'published'
        </where>
        order by pa.create_time desc
    </select>

    <!-- 根据ID查询（排除已逻辑删除） -->
    <select id="selectPortalArticleById" parameterType="Long" resultMap="PortalArticleResult">
        <include refid="selectPortalArticleVo"/>
        where pa.id = #{id} and pa.del_flag = '0'
    </select>

    <!-- 根据ID列表批量查询已发布文章（用于"我的收藏"等场景，仅返回 published） -->
    <select id="selectArticlesByIds" resultMap="PortalArticleResult">
        <include refid="selectPortalArticleVo"/>
        <where>
            pa.del_flag = '0'
            AND pa.status = 'published'
            AND pa.id IN
            <foreach item="id" collection="ids" open="(" separator="," close=")">
                #{id}
            </foreach>
        </where>
        order by pa.published_at desc, pa.create_time desc
    </select>

    <!-- 我购买的文章（付费阅读）分页查询：JOIN portal_tip_order 取已支付购买记录 -->
    <select id="selectPurchasedArticlesPage" resultMap="PortalArticleResult">
        <include refid="selectPortalArticleVo"/>
        INNER JOIN portal_tip_order t ON t.target_type = 'article_paid'
                                      AND t.target_id = pa.id
                                      AND t.status = 'paid'
        WHERE pa.del_flag = '0'
          AND pa.status = 'published'
          AND t.user_id = #{userId}
        ORDER BY t.paid_time DESC
    </select>

    <!-- 根据别名查询（排除已逻辑删除） -->
    <select id="selectPortalArticleBySlug" parameterType="String" resultMap="PortalArticleResult">
        <include refid="selectPortalArticleVo"/>
        where pa.slug = #{slug} and pa.del_flag = '0'
    </select>

    <!-- 新增文章 -->
    <insert id="insertPortalArticle" parameterType="com.moyun.portal.domain.entity.PortalArticle"
            useGeneratedKeys="true" keyProperty="id">
        insert into portal_article
        <trim prefix="(" suffix=")" suffixOverrides=",">
            title, slug, content, excerpt, cover,
            <if test="authorId != null">author_id,</if>
            <if test="authorBusinessId != null">author_business_id,</if>
            <if test="categoryId != null">category_id,</if>
            <if test="categoryBusinessId != null">category_business_id,</if>
            <if test="rootCategoryId != null">root_category_id,</if>
            <if test="rootCategoryBusinessId != null">root_category_business_id,</if>
            <if test="categoryPath != null">category_path,</if>
            <if test="status != null">status,</if>
            <if test="isFeatured != null">is_featured,</if>
            <if test="isTop != null">is_top,</if>
            <if test="isCarousel != null">is_carousel,</if>
            <if test="isCategoryRecommended != null">is_category_recommended,</if>
            <if test="views != null">views,</if>
            <if test="likes != null">likes,</if>
            <if test="comments != null">comments,</if>
            <if test="shareCount != null">share_count,</if>
            <if test="bookmarkCount != null">bookmark_count,</if>
            <if test="publishedAt != null">published_at,</if>
            <if test="link != null">link,</if>
            <if test="editorMode != null">editor_mode,</if>
            <if test="sessionToken != null">session_token,</if>
            <if test="contentMarkdown != null">content_markdown,</if>
            <if test="isPaid != null">is_paid,</if>
            <if test="paidContent != null">paid_content,</if>
            <if test="previewLength != null">preview_length,</if>
            <if test="price != null">price,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="businessId != null">business_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            #{title}, #{slug}, #{content}, #{excerpt}, #{cover},
            <if test="authorId != null">#{authorId},</if>
            <if test="authorBusinessId != null">#{authorBusinessId},</if>
            <if test="categoryId != null">#{categoryId},</if>
            <if test="categoryBusinessId != null">#{categoryBusinessId},</if>
            <if test="rootCategoryId != null">#{rootCategoryId},</if>
            <if test="rootCategoryBusinessId != null">#{rootCategoryBusinessId},</if>
            <if test="categoryPath != null">#{categoryPath},</if>
            <if test="status != null">#{status},</if>
            <if test="isFeatured != null">#{isFeatured},</if>
            <if test="isTop != null">#{isTop},</if>
            <if test="isCarousel != null">#{isCarousel},</if>
            <if test="isCategoryRecommended != null">#{isCategoryRecommended},</if>
            <if test="views != null">#{views},</if>
            <if test="likes != null">#{likes},</if>
            <if test="comments != null">#{comments},</if>
            <if test="shareCount != null">#{shareCount},</if>
            <if test="bookmarkCount != null">#{bookmarkCount},</if>
            <if test="publishedAt != null">#{publishedAt},</if>
            <if test="link != null">#{link},</if>
            <if test="editorMode != null">#{editorMode},</if>
            <if test="sessionToken != null">#{sessionToken},</if>
            <if test="contentMarkdown != null">#{contentMarkdown},</if>
            <if test="isPaid != null">#{isPaid},</if>
            <if test="paidContent != null">#{paidContent},</if>
            <if test="previewLength != null">#{previewLength},</if>
            <if test="price != null">#{price},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="businessId != null">#{businessId},</if>
        </trim>
    </insert>

    <!-- 修改文章 -->
    <update id="updatePortalArticle" parameterType="com.moyun.portal.domain.entity.PortalArticle">
        update portal_article
        <set>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="slug != null">slug = #{slug},</if>
            <if test="content != null">content = #{content},</if>
            <if test="excerpt != null">excerpt = #{excerpt},</if>
            <if test="cover != null">cover = #{cover},</if>
            <if test="authorId != null">author_id = #{authorId},</if>
            <if test="authorBusinessId != null">author_business_id = #{authorBusinessId},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="categoryBusinessId != null">category_business_id = #{categoryBusinessId},</if>
            <if test="rootCategoryId != null">root_category_id = #{rootCategoryId},</if>
            <if test="rootCategoryBusinessId != null">root_category_business_id = #{rootCategoryBusinessId},</if>
            <if test="categoryPath != null">category_path = #{categoryPath},</if>
            <if test="status != null">status = #{status},</if>
            <if test="isFeatured != null">is_featured = #{isFeatured},</if>
            <if test="isTop != null">is_top = #{isTop},</if>
            <if test="isCarousel != null">is_carousel = #{isCarousel},</if>
            <if test="isCategoryRecommended != null">is_category_recommended = #{isCategoryRecommended},</if>
            <if test="views != null">views = #{views},</if>
            <if test="likes != null">likes = #{likes},</if>
            <if test="comments != null">comments = #{comments},</if>
            <if test="shareCount != null">share_count = #{shareCount},</if>
            <if test="bookmarkCount != null">bookmark_count = #{bookmarkCount},</if>
            <if test="publishedAt != null">published_at = #{publishedAt},</if>
            <if test="link != null">link = #{link},</if>
            <if test="editorMode != null">editor_mode = #{editorMode},</if>
            <if test="sessionToken != null">session_token = #{sessionToken},</if>
            <if test="contentMarkdown != null">content_markdown = #{contentMarkdown},</if>
            <if test="isPaid != null">is_paid = #{isPaid},</if>
            <if test="paidContent != null">paid_content = #{paidContent},</if>
            <if test="previewLength != null">preview_length = #{previewLength},</if>
            <if test="price != null">price = #{price},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="businessId != null">business_id = #{businessId},</if>
        </set>
        where id = #{id}
    </update>

    <!-- v5.9 逻辑删除：与 BaseEntity.delFlag 对齐，避免物理删除导致数据丢失与孤儿关联 -->
    <update id="deletePortalArticleById" parameterType="Long">
        update portal_article set del_flag = '2' where id = #{id}
    </update>

    <!-- 批量逻辑删除文章 -->
    <update id="deletePortalArticleByIds" parameterType="Long">
        update portal_article set del_flag = '2' where id in
        <foreach item="item" collection="array" open="(" separator="," close=")">
            #{item}
        </foreach>
    </update>

    <!-- ========== CMS专用查询（不限制状态） ========== -->

    <!-- CMS分页查询文章（所有状态） -->
    <select id="selectCmsArticlePage" resultMap="CmsArticleResult">
        <include refid="selectCmsArticleVo"/>
        <include refid="queryWhereCms"/>
        <include refid="dynamicOrderBy"/>
    </select>

    <!-- CMS不分页查询文章（所有状态） -->
    <select id="selectCmsArticleList" resultMap="CmsArticleResult">
        <include refid="selectCmsArticleVo"/>
        <include refid="queryWhereCms"/>
        <include refid="defaultOrderBy"/>
    </select>

    <!-- CMS根据ID查询文章（排除已逻辑删除） -->
    <select id="selectCmsArticleById" parameterType="Long" resultMap="CmsArticleResult">
        <include refid="selectCmsArticleVo"/>
        where pa.id = #{id} and pa.del_flag = '0'
    </select>

</mapper>
