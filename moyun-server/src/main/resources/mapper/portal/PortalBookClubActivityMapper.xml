<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moyun.portal.mapper.PortalBookClubActivityMapper">

    <resultMap type="com.moyun.ext.cms.domain.vo.BookClubActivityVO" id="BookClubActivityVOResult">
        <id     property="id"                  column="id"                   />
        <result property="title"               column="title"                />
        <result property="bookId"              column="book_id"              />
        <result property="description"         column="description"          />
        <result property="cover"               column="cover"                />
        <result property="startDate"           column="start_date"           />
        <result property="endDate"             column="end_date"             />
        <result property="maxParticipants"     column="max_participants"     />
        <result property="currentParticipants" column="current_participants" />
        <result property="createdBy"           column="created_by"           />
        <result property="status"              column="status"               />
        <result property="createTime"          column="create_time"          />
        <result property="participantsCount"   column="participants_count"  />
        <result property="recordsCount"        column="records_count"        />
        <result property="isJoined"            column="is_joined"            />
    </resultMap>

    <!-- 分页查询活动列表（含参与人数、记录数聚合，及当前用户是否已加入标记） -->
    <select id="selectListWithCount" resultMap="BookClubActivityVOResult">
        select a.id, a.title, a.book_id, a.description, a.cover, a.start_date, a.end_date,
               a.max_participants, a.current_participants, a.created_by, a.status, a.create_time,
               (select count(1) from portal_book_club_participant p where p.activity_id = a.id) as participants_count,
               (select count(1) from portal_book_club_record r where r.activity_id = a.id) as records_count,
               case
                   when #{currentUserId} is null then 0
                   when exists (select 1 from portal_book_club_participant p2
                                where p2.activity_id = a.id and p2.user_id = #{currentUserId}) then 1
                   else 0
               end as is_joined
        from portal_book_club_activity a
        order by a.create_time desc
    </select>

</mapper>
