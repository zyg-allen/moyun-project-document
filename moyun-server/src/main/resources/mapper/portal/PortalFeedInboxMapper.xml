<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moyun.portal.mapper.PortalFeedInboxMapper">

    <!-- 批量插入收件箱记录（向多个粉丝推送同一条事件） -->
    <insert id="batchInsert">
        insert into portal_feed_inbox (user_id, event_id, created_time)
        values
        <foreach collection="followerIds" item="followerId" separator=",">
            (#{followerId}, #{eventId}, #{createdTime})
        </foreach>
    </insert>

    <!-- 根据事件ID删除收件箱记录（事件删除时同步清理） -->
    <delete id="deleteByEventId">
        delete from portal_feed_inbox where event_id = #{eventId}
    </delete>

</mapper>
