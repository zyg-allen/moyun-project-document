<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moyun.portal.mapper.PortalShopItemMapper">

    <resultMap type="com.moyun.portal.domain.entity.PortalShopItem" id="PortalShopItemResult">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="cover" column="cover"/>
        <result property="type" column="type"/>
        <result property="pointsCost" column="points_cost"/>
        <result property="stock" column="stock"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectItemVo">
        select id, name, description, cover, type, points_cost, stock, status, create_by, create_time, update_by, update_time, remark from portal_shop_item
    </sql>

    <!-- 分页查询 -->
    <select id="selectItemPage" resultMap="PortalShopItemResult">
        <include refid="selectItemVo"/>
        <where>
            <if test="query.name != null and query.name != ''">and name like concat('%', #{query.name}, '%')</if>
            <if test="query.type != null and query.type != ''">and type = #{query.type}</if>
            <if test="query.status != null and query.status != ''">and status = #{query.status}</if>
        </where>
        order by create_time desc
    </select>

    <!-- 上架商品列表（前台公开） -->
    <select id="selectActiveItems" resultMap="PortalShopItemResult">
        <include refid="selectItemVo"/>
        where status = 'active'
        order by points_cost asc, id asc
    </select>
</mapper>
