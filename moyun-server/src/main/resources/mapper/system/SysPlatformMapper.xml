<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moyun.system.mapper.SysPlatformMapper">

    <resultMap type="com.moyun.system.domain.entity.SysPlatform" id="SysPlatformResult">
        <id property="id" column="id"/>
        <result property="platformCode" column="platform_code"/>
        <result property="platformName" column="platform_name"/>
        <result property="platformType" column="platform_type"/>
        <result property="description" column="description"/>
        <result property="domain" column="domain"/>
        <result property="icon" column="icon"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectPlatformOptionselect" resultMap="SysPlatformResult">
        select id, platform_code, platform_name, platform_type, description, `domain`, icon, sort_order, status, create_time
        from sys_platform
        where status = 1
        order by sort_order asc
    </select>

</mapper>
